{
  "manifest_version": 3,
  "name": "Prime Voice Hack v2.0",
  "version": "2.0",
  "description": "Odczytuje napisy z Prime Video (Lokalnie lub na Telefonie).",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://broker.emqx.io/*",
    "*://*.primevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*", "*://*.primevideo.com/*"],
      "js": ["content.js"],
      "css": ["hacker_overlay.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/mqtt.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}